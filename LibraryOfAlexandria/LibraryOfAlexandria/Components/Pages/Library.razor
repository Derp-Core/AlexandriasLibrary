@page "/library"
@using LibraryOfAlexandria.Models
@using LibraryOfAlexandria.Services
@rendermode InteractiveServer
@inject SteamService Steam
@inject SteamSpyService SteamSpy

<input @bind="input" placeholder="SteamID or custom URL name" />
<button @onclick="Load">Load</button>
<button @onclick="() => grid = !grid">@(grid ? "List" : "Grid") view</button>
<button @onclick="LoadDetails" disabled="@loadingDetails">Load achievements and tags</button>
<span>@progress</span>

<p>@message</p>

<div class="@(grid ? "game-grid" : "game-list")">
    @foreach (var g in games)
    {
        <div class="game-card">
            <img src="@g.HeaderUrl" loading="lazy" />
            <h4>@g.Name</h4>
            <small>@(g.PlaytimeMinutes / 60) hrs</small>
            @if (g.AchievementsTotal is not null)
            {
                <div>
                    <progress value="@g.AchievementsEarned" max="@g.AchievementsTotal"></progress>
                    <small>@g.AchievementsEarned / @g.AchievementsTotal</small>
                </div>
            }
            <div>
                @foreach (var t in g.Tags)
                {
                    <span class="tag">@t</span>
                }
            </div>
        </div>
    }
</div>

@code {
    string input = ""; string message = ""; bool grid = true;
    string steamId = "";
    bool loadingDetails = false;
    string progress = "";
    List<OwnedGame> games = new();

    async Task Load()
    {
        var id = await Steam.ResolveSteamIdAsync(input);
        if (id is null) { message = "User not found."; return; }
        steamId = id;
        games = await Steam.GetOwnedGamesAsync(id);
        message = games.Count == 0 ? "No games found. Is the profile public?" : "";
    }

    async Task LoadDetails()
    {
        loadingDetails = true;
        int done = 0;
        foreach (var g in games)
        {
            try
            {
                var ach = await Steam.GetAchievementsAsync(steamId, g.AppId);
                if (ach is not null)
                {
                    g.AchievementsEarned = ach.Value.Earned;
                    g.AchievementsTotal = ach.Value.Total;
                }
                g.Tags = await SteamSpy.GetTopTagsAsync(g.AppId);
            }
            catch { /* skip games that fail */ }

            done++;
            progress = $"{done} / {games.Count}";
            StateHasChanged();
            await Task.Delay(1000);
        }
        loadingDetails = false;
    }
}